    },
    {
      "id": "C2",
      "estado": "atendido",
      "evidencia": "002_agents_documents.sql exige ULID em agents/documents; identity requer agent_id com FK e conteúdo; manifesto/projeto exigem agent_id NULL e notion_page_id. AgentRepository.seed cria Silas e os três registros, com conflitos idempotentes; integração SQL/seed declarada no loop."
    },
    {
      "id": "C3",
      "estado": "atendido",
      "evidencia": "Seed preserva ID de Silas por nome; catálogo e criação consultam AgentRepository, SendMessageService usa identidade/ID persistidos; integração HTTP com reinício e ULID consta do loop, e consumidor usa id recebido pelo catálogo."
    },
    {
      "id": "C4",
      "estado": "atendido",
      "evidencia": "Agent usa identity_content do banco como system_prompt e adiciona manifesto e research_project no primeiro turno. knowledge.py lê páginas do Notion, recorre aos arquivos locais em falha e rejeita documento ausente/vazio; três testes locais passaram."
    },
    {
      "id": "C5",
      "estado": "atendido",
