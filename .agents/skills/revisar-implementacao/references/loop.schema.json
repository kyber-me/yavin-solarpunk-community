{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento de controle de loop de correções",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "registrado_em",
    "anterior_ref",
    "limite_tentativas",
    "estado",
    "classificacao_ref",
    "planejamento_ref",
    "autorizacao_ref",
    "tentativas",
    "motivo"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "registrado_em": {
      "type": "string",
      "format": "date-time"
    },
    "anterior_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "limite_tentativas": {
      "const": 3
    },
    "estado": {
      "enum": [
        "aguardando_revisao",
        "aguardando_executor",
        "aprovado_tecnicamente",
        "aguardando_idealizador",
        "impedido"
      ]
    },
    "classificacao_ref": {
      "type": "string",
      "minLength": 1
    },
    "planejamento_ref": {
      "type": "string",
      "minLength": 1
    },
    "autorizacao_ref": {
      "type": "string",
      "minLength": 1
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    },
    "tentativas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numero",
          "implementation_id",
          "parent_implementation_id",
          "fase",
          "revisao_ref",
          "evidencias_execucao",
          "snapshot"
        ],
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "implementation_id": {
            "$ref": "#/$defs/ulid"
          },
          "parent_implementation_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/ulid"
              },
              {
                "type": "null"
              }
            ]
          },
          "fase": {
            "enum": [
              "executor_reservado",
              "entregue",
              "revisada",
              "falhou"
            ]
          },
          "revisao_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidencias_execucao": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "snapshot": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "arquivo",
                "sha256"
              ],
              "properties": {
                "arquivo": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
