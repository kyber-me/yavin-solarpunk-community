{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planejamento de tarefa delegada no backend",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "registrado_em",
    "planejado_em",
    "origem_registro",
    "classificacao_ref",
    "nivel",
    "tipo_planejamento",
    "modo_plan",
    "objetivo",
    "escopo",
    "criterios_aceitacao",
    "fases",
    "incertezas",
    "observacoes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "registrado_em": {
      "type": "string",
      "format": "date-time"
    },
    "planejado_em": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "origem_registro": {
      "enum": [
        "contemporanea",
        "retrospectiva"
      ]
    },
    "classificacao_ref": {
      "type": "string",
      "minLength": 1
    },
    "nivel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tipo_planejamento": {
      "enum": [
        "minimo",
        "abordagem_discutida",
        "decomposto"
      ]
    },
    "modo_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "justificativa"
      ],
      "properties": {
        "estado": {
          "enum": [
            "utilizado",
            "nao_utilizado",
            "indisponivel"
          ]
        },
        "justificativa": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objetivo": {
      "type": "string",
      "minLength": 1
    },
    "escopo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inclui",
        "exclui"
      ],
      "properties": {
        "inclui": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclui": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criterios_aceitacao": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "descricao",
          "verificacao"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "verificacao": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "objetivo",
          "depende_de",
          "tarefas"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "objetivo": {
            "type": "string",
            "minLength": 1
          },
          "depende_de": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tarefas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "descricao",
                "arquivos",
                "criterios_aceitacao",
                "validacoes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "descricao": {
                  "type": "string",
                  "minLength": 1
                },
                "arquivos": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "criterios_aceitacao": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "validacoes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    "incertezas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observacoes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nivel": {
            "minimum": 3
          }
        }
      },
      "then": {
        "properties": {
          "tipo_planejamento": {
            "const": "decomposto"
          },
          "fases": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origem_registro": {
            "const": "contemporanea"
          }
        }
      },
      "then": {
        "properties": {
          "planejado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
